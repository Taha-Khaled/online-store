<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Store.*]*</Include>
          <Exclude>[Store.*.Tests]*</Exclude>
          <ExcludeByFile>**/Persistence/Migrations/**/*.cs,**/Persistence/Configurations/**/*.cs,**/Seeding/Data/**/*.cs,**/Program.cs,**/DependencyInjection.cs,**/*Request.cs,**/*Response.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
